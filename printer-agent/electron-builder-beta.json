{
  "appId": "com.menuzia.assistente.beta",
  "productName": "Assistente Menuzia Beta",
  "directories": {
    "output": "dist-beta"
  },
  "extraMetadata": {
    "name": "menuzia-assistente-beta",
    "productName": "Assistente Menuzia Beta",
    "version": "1.1.1",
    "menuziaAmbiente": {
      "variante": "beta",
      "apiBaseUrl": "https://app.menuzia.com.br",
      "pastaDados": "menuzia-assistente-beta",
      "appUserModelId": "com.menuzia.assistente.beta",
      "nomeInicio": "Assistente Menuzia Beta",
      "nomeExibicao": "Assistente Menuzia Alfa 1"
    }
  },
  "protocols": [
    {
      "name": "Menuzia (conectar o Assistente)",
      "schemes": [
        "menuzia"
      ]
    }
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Assistente Menuzia Alfa 1",
    "uninstallDisplayName": "Assistente Menuzia Alfa 1 ${version}",
    "artifactName": "AssistenteMenuziaAlfa1-Setup-${version}.${ext}",
    "include": "build-beta/instalador-beta.nsh"
  },
  "files": [
    "src/**/*",
    "!src/**/*.test.ts",
    "!src/**/*.d.ts",
    "package.json"
  ],
  "asarUnpack": [
    "src/*.ps1",
    "src/fonts/**"
  ],
  "publish": [
    {
      "provider": "generic",
      "url": "https://app.menuzia.com.br/api/agente/atualizacao"
    }
  ]
}
